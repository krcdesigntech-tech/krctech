# ================================
# KRCTech DocAI - 환경 변수 설정
# ================================
# 이 파일을 .env.local로 복사하고 실제 값을 입력하세요.
# .env.local 파일은 절대 git에 커밋하지 마세요.

# ── Supabase ──────────────────────────────────────────
# Supabase 프로젝트 → Settings → API에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (서버에서만 사용, 절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Cloudflare R2 ─────────────────────────────────────
# Cloudflare Dashboard → R2 → Manage R2 API Tokens에서 생성
CF_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=krctech-documents

# ── HuggingFace ───────────────────────────────────────
# https://huggingface.co/settings/tokens 에서 생성 (Write 토큰)
# 서버에서만 사용
HF_TOKEN=hf_your_token_here

# ── 법제처 국가법령정보 OPEN API ──────────────────────
# https://open.law.go.kr 에 이메일로 가입 후 발급받는 OC(이메일 ID).
# 예: 메일이 abc@xyz.com이면 LAW_OPEN_API_OC=abc
# 서버에서만 사용합니다.
LAW_OPEN_API_OC=your_open_law_oc

# ── Bot Worker ────────────────────────────────────────
# bot/krctech_qa_worker.py 와 공유하는 시크릿 (동일 값 설정)
WORKER_SECRET=your-bot-worker-secret

# ── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
