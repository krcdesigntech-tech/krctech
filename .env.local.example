# ================================
# KRCTech DocAI - 환경 변수 설정
# ================================
# 이 파일을 .env.local로 복사하고 실제 값을 입력하세요.
# .env.local 파일은 절대 git에 커밋하지 마세요.

# ── Supabase ──────────────────────────────────────────
# Supabase 프로젝트 → Settings → API에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (서버에서만 사용, 절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Cloudflare R2 ─────────────────────────────────────
# Cloudflare Dashboard → R2 → Manage R2 API Tokens에서 생성
CF_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=krctech-documents

# ── Google Gemini (임베딩 전용) ───────────────────────
# https://aistudio.google.com/apikey 에서 발급. 서버에서만 사용.
# gemini-embedding-001, 768차원 사용.
GEMINI_API_KEY=your-gemini-api-key
# 임베딩 L2 정규화 on/off (기본 on). 수자원법령과 동일 결과 비교 시 false.
# EMBEDDING_NORMALIZE=true

# ── OpenRouter (답변 생성 전용) ───────────────────────
# https://openrouter.ai/keys 에서 발급. 서버에서만 사용.
# 무료 모델 폴백 체인은 src/lib/llm/openrouter-models.ts 에서 관리.
OPENROUTER_API_KEY=your-openrouter-api-key

# ── 법제처 국가법령정보 OPEN API ──────────────────────
# https://open.law.go.kr 에 이메일로 가입 후 발급받는 OC(이메일 ID).
# 예: 메일이 abc@xyz.com이면 LAW_OPEN_API_OC=abc
# 서버에서만 사용합니다.
LAW_OPEN_API_OC=your_open_law_oc

# ── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
